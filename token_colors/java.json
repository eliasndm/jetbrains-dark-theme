{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "name": "[Java] puncutation.separator.java",
      "scope": "punctuation.separator.java",
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "[Java] variable.language.wildcard.java",
      "scope": "variable.language.wildcard.java",
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "[Java] puctuation.definition.annotation",
      "scope": "punctuation.definition.annotation.java",
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "name": "[Java] storage.type.function.arrow.java",
      "scope": "storage.type.function.arrow.java",
      "settings": {
        "foreground": "#BCBEC4"
      }
    },
    {
      "name": "[Java] comment.documentation.variable",
      "scope": "comment.block.javadoc.java variable.parameter.java",
      "settings": {
        "foreground": "#ABADB3"
      }
    },
  ],
  "semanticTokenColors": {
    "interface:java": "#BCBEC4",
    "namespace:java": "#BCBEC4",
    "typeParameter:java": "#16BAAC",
    "enumMember:java": {
      "foreground": "#C77DBB",
      "fontStyle": "italic"
    },
    "annotation:java": "#B3AE60",
    "annotationMember:java": "#BCBEC4",
    "property:java": {
      "foreground": "#C77DBB",
    },
    "property.static:java": {
      "foreground": "#C77DBB",
      "fontStyle": "italic"
    },
    "method:java": "#BCBEC4",
    "method.static:java": {
      "foreground": "#BCBEC4",
      "fontStyle": "italic"
    },
    "method.public.declaration:java": "#56A8F5",
    "method.static.declaration:java": "#56A8F5",
    "class.declaration.constructor:java": "#56A8F5"
  }
}