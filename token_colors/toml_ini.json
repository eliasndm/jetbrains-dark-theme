{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "name": "[INI] Property",
      "scope": [
        "keyword.other.definition.ini",
        "punctuation.separator.key-value.ini"
      ],
      "settings": {
        "foreground": "#BCBEBC"
      }
    },
    {
      "name": "[INI] Property",
      "scope": "source.ini",
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "[INI] Section Title",
      "scope": [
        "entity.name.section.group-title.ini",
        "entity.name.section.group-title.ini punctuation.definition.entity.ini"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[TOML] Section Title",
      "scope": [
        "support.type.property-name.table.toml",
        "meta.array.table.toml support.type.property-name.array.toml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
  ]
}