{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "name": "[Markdown] Separator",
      "scope": [
        "meta.separator.markdown",
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] Heading",
      "scope": [
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Markdown] Bold, Italic",
      "scope": [
        "punctuation.definition.bold.markdown",
        "punctuation.definition.italic.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] Bold Markup",
      "scope": [
        "markup.bold.markdown",
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "[Markdown] Italic Markup",
      "scope": [
        "markup.italic.markdown",
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Markdown] Bold Italic Markup",
      "scope": [
        "markup.bold.markdown markup.italic.markdown",
      ],
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "[Markdown] Strikethrough",
      "scope": [
        "markup.strikethrough.markdown",
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "[Markdown] List",
      "scope": [
        "punctuation.definition.list.begin.markdown",
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] Quote Definition",
      "scope": [
        "punctuation.definition.quote.begin.markdown",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "[Markdown] Math Environment",
      "scope": [
        "punctuation.definition.math.begin.markdown",
        "punctuation.definition.math.end.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] Table Separator",
      "scope": [
        "punctuation.definition.table.markdown",
        "punctuation.separator.table.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] Link Description",
      "scope": [
        "string.other.link.description.markdown",
        "punctuation.definition.link.description.begin.markdown",
        "punctuation.definition.link.description.end.markdown"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "[Markdown] Link Title",
      "scope": [
        "string.other.link.title.markdown",
        "punctuation.definition.link.title.begin.markdown",
        "punctuation.definition.link.title.end.markdown"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "[Markdown] Auto Link Destination",
      "scope": [
        "markup.underline.link.markdown",
        "punctuation.definition.link.markdown",
        "meta.image.inline.markdown markup.underline.link.image.markdown"
      ],
      "settings": {
        "foreground": "#57AAF7"
      }
    },
    {
      "name": "[Markdown] Link Reference",
      "scope": [
        "meta.link.reference.def.markdown punctuation.definition.constant.markdown",
        "constant.other.reference.link.markdown",
        "meta.link.reference.markdown punctuation.definition.constant.begin.markdown",
        "meta.link.reference.markdown punctuation.definition.constant.end.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] code.fence.punctuation",
      "scope": [
        "markup.inline.raw.string.markdown punctuation.definition.raw.markdown",
        "markup.fenced_code.block.markdown punctuation.definition.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "[Markdown] fenced_code.block.language",
      "scope": [
        "fenced_code.block.language.markdown",
      ],
      "settings": {
        "foreground": "#C77DBB",
        "fontStyle": "italic"
      }
    },
  ]
}