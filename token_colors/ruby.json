{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "name": "[Ruby] keyword.special-method",
      "scope": [
        "keyword.other.special-method.ruby"
      ],
      "settings": {
        "foreground": "#FC9800",
      }
    },
    {
      "name": "[Ruby] variable",
      "scope": [
        "variable.ruby",
        "variable.other.readwrite.ruby"
      ],
      "settings": {
        "foreground": "#D4B01D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Ruby] variable.global",
      "scope": [
        "variable.other.readwrite.global.ruby",
        "variable.other.readwrite.global.pre-defined.ruby"
      ],
      "settings": {
        "foreground": "#D0D0FF",
      }
    },
    {
      "name": "[Ruby] entity.name.function",
      "scope": "entity.name.function.ruby",
      "settings": {
        "foreground": "#FFC66D",
      }
    },
    {
      "name": "[Ruby] entity.name.type.module",
      "scope": "entity.name.type.module.ruby",
      "settings": {
        "foreground": "#FFC66D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Ruby] entity.name.type.module",
      "scope": "variable.other.constant.ruby",
      "settings": {
        "foreground": "#FFC66D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Ruby] string.interpolation",
      "scope": "source.ruby punctuation.section.embedded",
      "settings": {
        "foreground": "#BCBEC4",
      }
    },
    {
      "name": "[Ruby] support.function.kernel",
      "scope": "support.function.kernel.ruby",
      "settings": {
        "foreground": "#BCBEC4",
      }
    },
    {
      "name": "[Ruby] variable.instance",
      "scope": [
        "variable.other.readwrite.instance.ruby",
        "variable.other.readwrite.class.ruby"
      ],
      "settings": {
        "foreground": "#C77DBB",
      }
    },
    {
      "name": "[Ruby] function.parameter",
      "scope": [
        "variable.parameter.function.ruby",
        "variable.other.block.ruby"
      ],
      "settings": {
        "foreground": "#D4B01D",
      }
    },
    {
      "name": "[Ruby] function.parameter",
      "scope": [
        "constant.language.symbol.ruby",
        "constant.language.symbol.hashkey.ruby"
      ],
      "settings": {
        "foreground": "#89A6AF",
      }
    },
    {
      "name": "[Ruby] numeric",
      "scope": [
        "constant.numeric.ruby"
      ],
      "settings": {
        "foreground": "#74A4C8",
      }
    },
    {
      "name": "[Ruby] comment",
      "scope": [
        "comment.line.number-sign.ruby",
        "punctuation.definition.comment.ruby"
      ],
      "settings": {
        "foreground": "#808080",
      }
    },
    {
      "name": "[Ruby] documentation.tag.yard",
      "scope": [
        "comment.line.keyword.yard.ruby",
        "comment.line.keyword.punctuation.yard.ruby"
      ],
      "settings": {
        "foreground": "#9a9a9a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "[Ruby] documentation.tag.yard",
      "scope": [
        "comment.line.parameter.yard.ruby",
        "comment.line.type.yard.ruby"
      ],
      "settings": {
        "foreground": "#9a9a9a",
      }
    },
  ],
  "semanticTokenColors": {
    "parameter:ruby": {
      "foreground": "#D4B01D",
      "fontStyle": "italic"
    },
    "variable:ruby": {
      "foreground": "#D4B01D",
      "fontStyle": "italic"
    },
  }
}