{
  "$schema": "vscode://schemas/color-theme",
  "tokenColors": [
    {
      "name": "[HTML] Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "punctuation.definition.tag.xml",
        "keyword.other.doctype.xml"
      ],
      "settings": {
        "foreground": "#D5B778"
      }
    },
    {
      "name": "[HTML] Attribute Name",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#BABABA"
      }
    },
    {
      "name": "[HTML] Punctuation Separator (=)",
      "scope": [
        "punctuation.separator.key-value.html",
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "[HTML] Entity Name",
      "scope": [
        "text.html constant.character.entity",
        "punctuation.definition.entity.html",
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "name": "[HTML] Custom Tag",
      "scope": [
        "meta.tag.custom.start.html entity.name.tag.html",
        "meta.tag.custom.end.html entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#2FBAA3"
      }
    },
  ]
}